// https://docs.renovatebot.com/configuration-options/

{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",

    "goGetDirs": ["./..."],
    "postUpdateOptions": ["gomodUpdateImportPaths"],

    "packageRules": [
        {
            "matchManagers": ["gomod"],
            "postUpgradeTasks": {
                "commands": [
                    // use manual go mod tidy to get the override when using hugo.json
                    "go mod tidy",
                    // fail when a dependency forced a go directive bump: the artifact error fails the CI pipeline, so GitLab cancels auto-merge.
                    "git diff --exit-code -G^go -- go.mod"
                ],
                "executionMode": "update",
                "workingDirTemplate": "{{{packageFileDir}}}"
            }
        },
        {
            // block all updates on "go" directive in go.mod (but not "toolchain" directive)
            "enabled": false,
            "matchDepNames": ["go"],
            "matchDepTypes": ["golang"],
            "matchManagers": ["gomod"]
        },
        {
            "automerge": true,
            // force grouping of go.mod minor versions, even for pre-1.0 versions
            "matchManagers": ["gomod"],
            "matchUpdateTypes": ["!major"],
            "groupName": "Go dependencies",
            "groupSlug": "go-dependencies"
        },
        {
            "matchDepNames": ["go"],
            "matchDepTypes": ["toolchain"],
            "matchManagers": ["gomod"],
            "groupName": "Go toolchain dependency",
            "groupSlug": "toolchain-dependency",
            "semanticCommitType": "ci"
        },
        {
            "automerge": true,
            "matchDepNames": ["go"],
            "matchDepTypes": ["toolchain"],
            "matchManagers": ["gomod"],
            "matchUpdateTypes": ["!major"]
        }
    ]
}
